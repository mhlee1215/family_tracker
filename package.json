{
  "name": "family_tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "npm run sync:build && node scripts/start-server.js",
    "test": "npm run test:node",
    "check:turso": "node scripts/check-turso.js",
    "check:r2": "node scripts/check-r2-config.js",
    "seed:turso:tasks": "node scripts/reset-seed-tasks.js",
    "sync:build": "node scripts/sync-build-metadata.js",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "bump:build": "node scripts/bump-build.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:setup": "playwright install --with-deps chromium",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:node": "node --test tests/*.test.js",
    "test:ui": "vitest run tests/ui/main.test.js",
    "test:ci": "npm run test:node && npm run test:ui"
  },
  "dependencies": {
    "@better-scroll/core": "^2.5.1",
    "@better-scroll/wheel": "^2.5.1",
    "@libsql/client": "^0.15.15",
    "chart.js": "^4.5.1",
    "sortablejs": "^1.15.7",
    "swiped": "^0.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "happy-dom": "^20.9.0",
    "vitest": "^4.1.7"
  }
}
