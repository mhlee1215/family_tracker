LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Storage. Omit Turso values to use local SQLite.
DATABASE_PROVIDER=sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Media storage for production originals. Keep R2_PUBLIC_BASE_URL blank for private/signed URLs.
MEDIA_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
MEDIA_UPLOAD_MAX_IMAGE_BYTES=10485760
MEDIA_UPLOAD_MAX_VIDEO_BYTES=104857600

# Google OAuth login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:4174

# Optional Slack -> GitHub task intake.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=mhlee1215/family_tracker
GITHUB_DEFAULT_BRANCH=main
GITHUB_DISPATCH_EVENT=family_tracker_slack_request
PUBLIC_BASE_URL=
SLACK_BOT_PORT=8787
